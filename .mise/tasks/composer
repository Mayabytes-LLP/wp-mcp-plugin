COMPOSER_PHAR="${MISE_PROJECT_ROOT:-$PWD}/.mise/bin/composer.phar"
if [ ! -f "$COMPOSER_PHAR" ]; then
	mkdir -p "$(dirname "$COMPOSER_PHAR")"
	echo "fetching composer.phar -> $COMPOSER_PHAR" >&2
	curl -fsSL "https://getcomposer.org/composer-stable.phar" -o "$COMPOSER_PHAR"
	chmod +x "$COMPOSER_PHAR"
fi

cd "$PLUGIN_DIR"
exec php "$COMPOSER_PHAR" "$@"
